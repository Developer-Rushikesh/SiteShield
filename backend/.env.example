SECRET_KEY=django-insecure-24monitor-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=siteshield-8obg.onrender.com,.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://site-shield-rose.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Email Delivery Configuration (Google SMTP / App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=SiteShield 24 Monitor <your_email@gmail.com>

# Brevo (Sendinblue) Transactional Email API (HTTPS)
BREVO_API_KEY=your_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=SiteShield

